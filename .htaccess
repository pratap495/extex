Options -Indexes
DirectoryIndex index.php index.html
RewriteEngine On
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^index\.html$ index [R=301,L]
RewriteRule ^(about|aluminium-extrusion-explained|aluminium-profile-cutting-guide|aluminium-profile-selection|apply-upload-resume|blogs|careers|contact|custom-aluminium-profile-design|fabrication|gallery|industries|materials|partners-procurement|perforated-aluminium|products|profile-cutting|profile-design|quality|sales-marketing|upload-resume)\.html$ $1 [R=301,L]
RewriteRule ^index/?$ index.php [L,QSA]
RewriteRule ^(about|aluminium-extrusion-explained|aluminium-profile-cutting-guide|aluminium-profile-selection|apply-upload-resume|blogs|careers|contact|custom-aluminium-profile-design|fabrication|gallery|industries|materials|partners-procurement|perforated-aluminium|products|profile-cutting|profile-design|quality|sales-marketing|upload-resume)/?$ page.php?slug=$1 [L,QSA]
RewriteRule ^login/?$ php-backend/login.php [L,QSA]
RewriteRule ^admin/settings/?$ php-backend/cms-settings.php [L,QSA]
RewriteRule ^admin/?$ php-backend/cms-admin.php [L,QSA]
RewriteRule ^logout/?$ php-backend/logout.php [L,QSA]
