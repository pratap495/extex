Options -Indexes
DirectoryIndex index.php index.html
RewriteEngine On
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^profile-cutting(\.html)?/?$ capabilities#cutting [R=301,L]
RewriteRule ^(fabrication|profile-design|materials|perforated-aluminium)(\.html)?/?$ capabilities#$1 [R=301,L]
RewriteRule ^index\.html$ index [R=301,L]
RewriteRule ^(about|aluminium-extrusion-explained|aluminium-profile-cutting-guide|aluminium-profile-selection|apply-upload-resume|blogs|careers|contact|custom-aluminium-profile-design|fabrication|gallery|industries|materials|capabilities|our-clients|our-team|flat-rolled|floor-strips|industrial|motors|office-partition|pipes|plates|profiles|railing|rods|solar-sections|tubes|extrusions|partners-procurement|products|quality|sales-marketing|upload-resume)\.html$ $1 [R=301,L]
RewriteRule ^index/?$ index.php [L,QSA]
RewriteRule ^(about|aluminium-extrusion-explained|aluminium-profile-cutting-guide|aluminium-profile-selection|apply-upload-resume|blogs|careers|contact|custom-aluminium-profile-design|fabrication|gallery|industries|materials|capabilities|our-clients|our-team|flat-rolled|floor-strips|industrial|motors|office-partition|pipes|plates|profiles|railing|rods|solar-sections|tubes|extrusions|partners-procurement|products|quality|sales-marketing|upload-resume)/?$ page.php?slug=$1 [L,QSA]
RewriteRule ^login/?$ php-backend/login.php [L,QSA]
RewriteRule ^admin/settings/?$ php-backend/cms-settings.php [L,QSA]
RewriteRule ^admin/?$ php-backend/cms-admin.php [L,QSA]
RewriteRule ^logout/?$ php-backend/logout.php [L,QSA]
